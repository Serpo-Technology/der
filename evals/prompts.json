    {
      "id": "md-to-pdf",
      "prompt": "A markdown to PDF converter: pick a markdown file, convert it to a PDF titled with the file name, show how many pages came out, and save the PDF",
      "behavior": {
        "file": {
          "name": "notes.md",
          "mime": "text/markdown",
          "text": "# Notes\n\nFirst paragraph of the document.\n\n- point one\n- point two"
