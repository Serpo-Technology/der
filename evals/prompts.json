              "open",
              "pick",
              "choose"
            ],
            "optional": true
          },
          {
            "do": "click",
            "on": [
              "convert",
              "make",
              "create",
              "generate"
            ]
          },
          {
            "do": "click",
            "on": [
              "save",
              "download"
            ],
            "optional": true
          },
          {
            "expect": "fileSaved",
            "match": "/\\.pdf/",
            "dataPrefix": "JVBERi"
          },
          {
            "expect": "text",
            "match": "/\\b1\\b/"
          }
        ]
      }
