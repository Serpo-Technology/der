{
  "formatVersion": 1,
  "prompts": [
    {
      "id": "todo-basic",
      "prompt": "Create a todo list app with add, delete, and mark complete functionality",
      "behavior": {
        "steps": [
          {
            "do": "type",
            "into": [
              "task",
              "todo",
              "item",
              "what"
            ],
            "value": "buy milk"
          },
          {
            "do": "click",
            "on": [
              "add"
            ]
          },
          {
            "expect": "text",
            "match": "buy milk"
          },
          {
            "expect": "rowCount",
            "count": 1
          },
          {
            "do": "toggleInRow",
            "row": "buy milk"
          },
          {
            "do": "clickInRow",
            "row": "buy milk",
            "on": [
              "delete",
              "remove"
            ]
          },
          {
            "expect": "noText",
            "match": "buy milk"
          }
        ]
      }
    },
    {
      "id": "todo-search",
      "prompt": "Task list where I can add tasks, with a search box that filters as you type",
      "behavior": {
        "steps": [
          {
            "do": "type",
            "into": [
              "task",
              "todo",
              "add",
              "new"
            ],
            "value": "wash car"
          },
          {
            "do": "click",
            "on": [
              "add"
            ]
          },
          {
            "do": "type",
            "into": [
              "task",
              "todo",
              "add",
              "new"
            ],
            "value": "write report"
          },
          {
            "do": "click",
            "on": [
              "add"
            ]
          },
          {
            "expect": "rowCount",
            "count": 2
          },
          {
            "do": "type",
            "into": [
              "search",
              "filter"
            ],
            "value": "wash"
          },
          {
            "expect": "text",
            "match": "wash car"
          },
          {
            "expect": "noText",
            "match": "write report"
          }
        ]
      }
    },
    {
      "id": "kanban",
      "prompt": "Team kanban board with todo, doing, and done columns. Cards have a title and an owner. Buttons to move cards between columns and to delete them. Show a count per column. Dark theme.",
      "behavior": {
        "steps": [
          {
            "do": "type",
            "into": [
              "title",
              "card",
              "task"
            ],
            "value": "Ship docs"
          },
          {
            "do": "type",
            "into": [
              "owner",
              "assignee",
              "who"
            ],
            "value": "Ana"
          },
          {
            "do": "click",
            "on": [
              "add"
            ]
          },
          {
            "expect": "text",
            "match": "Ship docs"
          },
          {
            "expect": "text",
            "match": "Ana"
          },
          {
            "do": "clickInRow",
            "row": "Ship docs",
            "on": [
              "delete",
              "remove"
            ]
          },
          {
            "expect": "noText",
            "match": "Ship docs"
          }
        ]
      }
    },
    {
      "id": "contacts",
      "prompt": "Contact manager: add contacts with name, company, and email. Click a contact in the list to see a detail panel with all fields and a delete button. Show how many contacts exist.",
      "behavior": {
