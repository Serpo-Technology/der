# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
/target
*.local
.env

# Editor directories and files
.vscode
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Wasm parts: signing secrets and build output stay local
fragments/keys/*.key
fragments/*/target/
# Signed bundles under fragments/dist stay tracked (the bare dist rule above matches it)
!fragments/dist/
llama.cpp/
native/macos/.build/
src-tauri/binaries/

# Kernel crates: build output stays local, the dist wasm artifact is committed
runtime-core/target/
runtime-wasm/target/
!runtime-wasm/dist/
