              },
              {
                "name": "url",
                "source": "item",
                "sourceId": "href"
              }
            ],
            "outputs": [
              {
                "name": "blocks",
                "target": "state",
                "targetId": "pageBlocks"
              },
              {
                "name": "title",
                "target": "state",
                "targetId": "pageTitle"
              }
            ],
            "triggers": []
          }
        ],
        "layout": {
          "type": "flex",
