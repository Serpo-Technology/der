      "fragmentDefs": {
        "basics.entry_row": {
          "name": "basics.entry_row",
          "description": "entry row",
          "params": [
            {
              "name": "label",
              "type": "string",
              "required": true
            },
            {
              "name": "placeholder",
              "type": "string",
              "default": ""
            },
            {
              "name": "buttonText",
              "type": "string",
              "default": "Add"
            },
            {
              "name": "operationId",
              "type": "operationId",
              "required": true
            }
          ],
          "template": {
            "id": "{{id}}-row",
            "type": "container",
            "properties": {
              "direction": "row",
              "gap": "8",
              "align": "end"
            },
            "children": [
              {
                "id": "{{id}}-input",
                "type": "input",
                "properties": {
                  "label": "{{label}}",
                  "placeholder": "{{placeholder}}"
                }
              },
              {
                "id": "{{id}}-btn",
                "type": "button",
                "properties": {
                  "text": "{{buttonText}}",
                  "variant": "primary"
                },
                "eventBindings": [
                  {
                    "event": "click",
                    "operationId": "{{operationId}}"
                  }
                ]
              }
            ]
          }
        },
        "basics.ticker": {
          "name": "basics.ticker",
          "description": "self-wired ticker",
          "params": [
            {
              "name": "label",
              "type": "string",
              "default": "Ticker"
            }
          ],
          "template": {
            "id": "{{id}}-box",
            "type": "container",
            "children": [
